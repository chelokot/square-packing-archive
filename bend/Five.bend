def Five.fits_at(~F: Kind(&2), ~field: K.Field<F>, +root: F, +root_below: A.Algebra.le(~F, ~field, A.Algebra.mul(~F, ~field, root, root), R.FieldRing.of_nat(~F, ~field, 2n)), +root_above: A.Algebra.le(~F, ~field, R.FieldRing.of_nat(~F, ~field, 2n), A.Algebra.mul(~F, ~field, root, root)), +root_sign: A.Algebra.le(~F, ~field, A.Algebra.zero(~F, ~field), root), +index: Nat, +bound: N.Natural.Le(1n+index, 5n), +point: P.Problem.Point<F>,
  +containment: P.Problem.Containment<F, field, Five.square(~F, ~field, root, root_below, root_above, root_sign, index), point>) -> P.Problem.InContainer<F, field, A.Algebra.add(~F, ~field, R.FieldRing.of_nat(~F, ~field, 2n), A.Algebra.mul(~F, ~field, root, A.Algebra.half(~F, ~field))), point>:
