  first: P.Problem.InteriorContainment<F, field, Five.square(~F, ~field, root, root_below, root_above, root_sign, left), point>,
  second: P.Problem.InteriorContainment<F, field, Five.square(~F, ~field, root, root_below, root_above, root_sign, right), point>) -> Empty:
  match point:
    case P.Point{+x, +y}:
