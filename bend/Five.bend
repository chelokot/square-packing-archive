    case P.Point{+x, +y}:
      Five.fits(~F, ~field, root, root_below, root_above, root_sign, index, bound, x, y, containment)

def Five.disjoint_at(~F: Kind(&2), ~field: K.Field<F>, +root: F, +root_below: A.Algebra.le(~F, ~field, A.Algebra.mul(~F, ~field, root, root), R.FieldRing.of_nat(~F, ~field, 2n)), +root_above: A.Algebra.le(~F, ~field, R.FieldRing.of_nat(~F, ~field, 2n), A.Algebra.mul(~F, ~field, root, root)), +root_sign: A.Algebra.le(~F, ~field, A.Algebra.zero(~F, ~field), root), +left: Nat, +right: Nat, +left_bound: N.Natural.Le(1n+left, 5n), +right_bound: N.Natural.Le(1n+right, 5n),
