  match s:
    case 0n:
      match low:
    case 1n+a:
      match a:
        case 0n:
          match low:
        case 1n+b:
          match b:
            case 0n:
              match low:
            case 1n+c:
              match c:
                case 0n:
                  Inl{{==}}
                case 1n+d:
                  match d:
                    case 0n:
                      Inr{{==}}
                    case 1n+e:
                      match high:

