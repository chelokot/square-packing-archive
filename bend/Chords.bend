def Chords.interior(~F: Kind(&2), ~field: K.Field<F>, +square: P.Problem.Square<F, field>, +x: F, +y: F, +signs: C.Certificate.Both<A.Algebra.le(~F, ~field, A.Algebra.zero(~F, ~field), P.Problem.cosine(F, field, square)), A.Algebra.le(~F, ~field, A.Algebra.zero(~F, ~field), P.Problem.sine(F, field, square))>,
  +above: O.FieldOrder.Strict(~F, ~field, I.Intervals.lo(F, Chords.chord(~F, ~field, square, x)), y), +below: O.FieldOrder.Strict(~F, ~field, y, I.Intervals.hi(F, Chords.chord(~F, ~field, square, x)))) ->
  P.Problem.InteriorContainment<F, field, square, P.Point{x, y}>:
  match signs:
    case C.Both{+cosine_sign, +sine_sign}:
      Chords.interior_by(~F, ~field, square, x, y, cosine_sign, sine_sign, K.Field.le_decidable(F, field)(x, Chords.left_end(~F, ~field, square)), K.Field.le_decidable(F, field)(Chords.right_end(~F, ~field, square), x), K.Field.le_decidable(F, field)(x, Chords.low_end(~F, ~field, square)), K.Field.le_decidable(F, field)(Chords.high_end(~F, ~field, square), x), above, below)

def Chords.inside(~F: Kind(&2), ~field: K.Field<F>, +square: P.Problem.Square<F, field>, +side: F, +corners: M.Membership.Corners<F, field, square, side>, +side_nonnegative: A.Algebra.le(~F, ~field, A.Algebra.zero(~F, ~field), side),
  +signs: C.Certificate.Both<A.Algebra.le(~F, ~field, A.Algebra.zero(~F, ~field), P.Problem.cosine(F, field, square)), A.Algebra.le(~F, ~field, A.Algebra.zero(~F, ~field), P.Problem.sine(F, field, square))>, +x: F) -> I.Intervals.Inside(~F, ~field, A.Algebra.zero(~F, ~field), side, Chords.chord(~F, ~field, square, x)):
  match signs:
    case C.Both{+cosine_sign, +sine_sign}:
      Chords.inside_by(~F, ~field, square, side, corners, side_nonnegative, cosine_sign, sine_sign, x, K.Field.le_decidable(F, field)(x, Chords.left_end(~F, ~field, square)), K.Field.le_decidable(F, field)(Chords.right_end(~F, ~field, square), x), K.Field.le_decidable(F, field)(x, Chords.low_end(~F, ~field, square)), K.Field.le_decidable(F, field)(Chords.high_end(~F, ~field, square), x))

def Chords.flat(~F: Kind(&2), ~field: K.Field<F>, +square: P.Problem.Square<F, field>, +signs: C.Certificate.Both<A.Algebra.le(~F, ~field, A.Algebra.zero(~F, ~field), P.Problem.cosine(F, field, square)), A.Algebra.le(~F, ~field, A.Algebra.zero(~F, ~field), P.Problem.sine(F, field, square))>, +x: F, +flat: A.Algebra.le(~F, ~field, I.Intervals.hi(F, Chords.chord(~F, ~field, square, x)), I.Intervals.lo(F, Chords.chord(~F, ~field, square, x)))) ->
  A.Algebra.le(~F, ~field, I.Intervals.hi(F, Chords.chord(~F, ~field, square, x)), A.Algebra.zero(~F, ~field)):
  match signs:
    case C.Both{+cosine_sign, +sine_sign}:
      Chords.flat_by(~F, ~field, square, cosine_sign, sine_sign, x, K.Field.le_decidable(F, field)(x, Chords.left_end(~F, ~field, square)), K.Field.le_decidable(F, field)(Chords.right_end(~F, ~field, square), x), K.Field.le_decidable(F, field)(x, Chords.low_end(~F, ~field, square)), K.Field.le_decidable(F, field)(Chords.high_end(~F, ~field, square), x), flat)

def Chords.apart(~F: Kind(&2), ~field: K.Field<F>, +first: P.Problem.Square<F, field>, +second: P.Problem.Square<F, field>, +side: F, +x: F,
  +first_signs: C.Certificate.Both<A.Algebra.le(~F, ~field, A.Algebra.zero(~F, ~field), P.Problem.cosine(F, field, first)), A.Algebra.le(~F, ~field, A.Algebra.zero(~F, ~field), P.Problem.sine(F, field, first))>, +second_signs: C.Certificate.Both<A.Algebra.le(~F, ~field, A.Algebra.zero(~F, ~field), P.Problem.cosine(F, field, second)), A.Algebra.le(~F, ~field, A.Algebra.zero(~F, ~field), P.Problem.sine(F, field, second))>,
  +first_inside: I.Intervals.Inside(~F, ~field, A.Algebra.zero(~F, ~field), side, Chords.chord(~F, ~field, first, x)), +second_inside: I.Intervals.Inside(~F, ~field, A.Algebra.zero(~F, ~field), side, Chords.chord(~F, ~field, second, x)),
  disjoint: @point: P.Problem.Point<F> -> P.Problem.InteriorContainment<F, field, first, point> -> P.Problem.InteriorContainment<F, field, second, point> -> Empty) ->
  I.Intervals.Apart(~F, ~field, Chords.chord(~F, ~field, first, x), Chords.chord(~F, ~field, second, x)):
  match first_inside second_inside:
    case C.Both{+first_low, first_rest} C.Both{+second_low, second_rest}:
      Chords.meet(~F, ~field, Chords.chord(~F, ~field, first, x), Chords.chord(~F, ~field, second, x), first_low, second_low,
        +flat => Chords.flat(~F, ~field, first, first_signs, x, flat), +flat => Chords.flat(~F, ~field, second, second_signs, x, flat),
        +y => +first_above => +first_below => +second_above => +second_below => disjoint(P.Point{x, y},
          Chords.interior(~F, ~field, first, x, y, first_signs, first_above, first_below), Chords.interior(~F, ~field, second, x, y, second_signs, second_above, second_below)))

def Chords.le_successor(n: Nat) -> N.Natural.Le(n, 1n+n):
  match n:
    case 0n:
      Unit{}
    case 1n+p:
      Chords.le_successor(p)

def Chords.normal(~F: Kind(&2), ~field: K.Field<F>, ~count: Nat, ~side: F, ~packing: P.Problem.Packing<F, field, count, side>, +index: Nat) -> P.Problem.Square<F, field>:
  Y.Symmetry.first_quadrant(~F, ~field, Pk.Packings.squares(F, field, count, side, packing)(index))

def Chords.at(~F: Kind(&2), ~field: K.Field<F>, ~count: Nat, ~side: F, ~packing: P.Problem.Packing<F, field, count, side>, +x: F, +index: Nat) -> I.Intervals.Interval<F>:
  Chords.chord(~F, ~field, Chords.normal(~F, ~field, ~count, ~side, ~packing, index), x)

def Chords.chords(~F: Kind(&2), ~field: K.Field<F>, ~count: Nat, ~side: F, ~packing: P.Problem.Packing<F, field, count, side>, +x: F, +n: Nat) -> List<&2, I.Intervals.Interval<F>>:
  match n:
    case 0n:
      Nil{}
    case 1n+p:
      Chords.at(~F, ~field, ~count, ~side, ~packing, x, p) <> Chords.chords(~F, ~field, ~count, ~side, ~packing, x, p)

def Chords.inside_at(~F: Kind(&2), ~field: K.Field<F>, ~count: Nat, ~side: F, ~packing: P.Problem.Packing<F, field, count, side>, +x: F, +index: Nat, +bound: N.Natural.Le(1n+index, count)) ->
  I.Intervals.Inside(~F, ~field, A.Algebra.zero(~F, ~field), side, Chords.at(~F, ~field, ~count, ~side, ~packing, x, index)):
  Chords.inside(~F, ~field, Chords.normal(~F, ~field, ~count, ~side, ~packing, index), side,
    M.Membership.first_quadrant_corners(~F, ~field, Pk.Packings.squares(F, field, count, side, packing)(index), side, M.Membership.corners_of(~F, ~field, Pk.Packings.squares(F, field, count, side, packing)(index), side, Pk.Packings.fits(F, field, count, side, packing)(index, bound), Pk.Packings.fits(F, field, count, side, packing)(index, bound), Pk.Packings.fits(F, field, count, side, packing)(index, bound), Pk.Packings.fits(F, field, count, side, packing)(index, bound))),
    Pk.Packings.side_nonnegative(F, field, count, side, packing), Y.Symmetry.first_quadrant_signs(~F, ~field, Pk.Packings.squares(F, field, count, side, packing)(index)), x)

def Chords.apart_at(~F: Kind(&2), ~field: K.Field<F>, ~count: Nat, ~side: F, ~packing: P.Problem.Packing<F, field, count, side>, +x: F, +left: Nat, +right: Nat, +left_bound: N.Natural.Le(1n+left, count), +right_bound: N.Natural.Le(1n+right, count),
  different: {left == right : Nat} -> Empty) -> I.Intervals.Apart(~F, ~field, Chords.at(~F, ~field, ~count, ~side, ~packing, x, left), Chords.at(~F, ~field, ~count, ~side, ~packing, x, right)):
  Chords.apart(~F, ~field, Chords.normal(~F, ~field, ~count, ~side, ~packing, left), Chords.normal(~F, ~field, ~count, ~side, ~packing, right), side, x,
    Y.Symmetry.first_quadrant_signs(~F, ~field, Pk.Packings.squares(F, field, count, side, packing)(left)), Y.Symmetry.first_quadrant_signs(~F, ~field, Pk.Packings.squares(F, field, count, side, packing)(right)),
    Chords.inside_at(~F, ~field, ~count, ~side, ~packing, x, left, left_bound), Chords.inside_at(~F, ~field, ~count, ~side, ~packing, x, right, right_bound),
    +point => first => second => Pk.Packings.disjoint(F, field, count, side, packing)(left, right, left_bound, right_bound, different, point,
      Y.Symmetry.first_quadrant_interior_back(~F, ~field, Pk.Packings.squares(F, field, count, side, packing)(left), point, first), Y.Symmetry.first_quadrant_interior_back(~F, ~field, Pk.Packings.squares(F, field, count, side, packing)(right), point, second)))

def Chords.within(~F: Kind(&2), ~field: K.Field<F>, ~count: Nat, ~side: F, ~packing: P.Problem.Packing<F, field, count, side>, +x: F, +n: Nat, +bound: N.Natural.Le(n, count)) -> I.Intervals.Within(~F, ~field, A.Algebra.zero(~F, ~field), side, Chords.chords(~F, ~field, ~count, ~side, ~packing, x, n)):
  match n:
    case 0n:
      Unit{}
    case 1n+p:
      C.Both{Chords.inside_at(~F, ~field, ~count, ~side, ~packing, x, p, bound), Chords.within(~F, ~field, ~count, ~side, ~packing, x, p, N.Natural.le_transitive(p, 1n+p, count, Chords.le_successor(p), bound))}

def Chords.apart_all(~F: Kind(&2), ~field: K.Field<F>, ~count: Nat, ~side: F, ~packing: P.Problem.Packing<F, field, count, side>, +x: F, +p: Nat, +p_bound: N.Natural.Le(1n+p, count), +m: Nat, +m_bound: N.Natural.Le(m, p)) ->
  I.Intervals.ApartAll(~F, ~field, Chords.at(~F, ~field, ~count, ~side, ~packing, x, p), Chords.chords(~F, ~field, ~count, ~side, ~packing, x, m)):
  match m:
    case 0n:
      Unit{}
    case 1n+q:
      C.Both{Chords.apart_at(~F, ~field, ~count, ~side, ~packing, x, p, q, p_bound,
        N.Natural.le_transitive(1n+q, p, count, m_bound, N.Natural.le_transitive(p, 1n+p, count, Chords.le_successor(p), p_bound)),
        same => N.Natural.not_successor_le_self(q, N.Natural.le_congruent(1n+q, p, 1n+q, q, m_bound, {==}, same))),
        Chords.apart_all(~F, ~field, ~count, ~side, ~packing, x, p, p_bound, q, N.Natural.le_transitive(q, 1n+q, p, Chords.le_successor(q), m_bound))}

def Chords.pairwise(~F: Kind(&2), ~field: K.Field<F>, ~count: Nat, ~side: F, ~packing: P.Problem.Packing<F, field, count, side>, +x: F, +n: Nat, +bound: N.Natural.Le(n, count)) -> I.Intervals.Pairwise(~F, ~field, Chords.chords(~F, ~field, ~count, ~side, ~packing, x, n)):
  match n:
    case 0n:
      Unit{}
    case 1n+p:
      C.Both{Chords.apart_all(~F, ~field, ~count, ~side, ~packing, x, p, bound, p, N.Natural.le_reflexive(p)), Chords.pairwise(~F, ~field, ~count, ~side, ~packing, x, p, N.Natural.le_transitive(p, 1n+p, count, Chords.le_successor(p), bound))}

def Chords.covered(~F: Kind(&2), ~field: K.Field<F>, ~count: Nat, ~side: F, ~packing: P.Problem.Packing<F, field, count, side>, +x: F) -> A.Algebra.le(~F, ~field, I.Intervals.total(~F, ~field, Chords.chords(~F, ~field, ~count, ~side, ~packing, x, count)), I.Intervals.minus(~F, ~field, side, A.Algebra.zero(~F, ~field))):
