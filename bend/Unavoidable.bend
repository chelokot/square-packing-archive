def Unavoidable.right_pair(~F: Kind(&2), ~field: K.Field<F>, +square: P.Problem.Square<F, field>, +corners: M.Membership.Corners<F, field, square, R.FieldRing.of_nat(~F, ~field, 3n)>,
  +cosine_sign: A.Algebra.le(~F, ~field, A.Algebra.zero(~F, ~field), P.Problem.cosine(F, field, square)), +sine_sign: A.Algebra.le(~F, ~field, A.Algebra.zero(~F, ~field), P.Problem.sine(F, field, square)), +left: F, +height: F, +gap: F,
  +hyp0: A.Algebra.le(~F, ~field, height, R.FieldRing.of_nat(~F, ~field, 1n)),
  +hyp1: A.Algebra.le(~F, ~field, R.FieldRing.of_nat(~F, ~field, 0n), gap),
  +hyp2: A.Algebra.le(~F, ~field, gap, R.FieldRing.of_nat(~F, ~field, 1n)),
  +hyp3: A.Algebra.le(~F, ~field, A.Algebra.add(~F, ~field, height, A.Algebra.mul(~F, ~field, gap, A.Algebra.mul(~F, ~field, P.Problem.cosine(F, field, square), P.Problem.sine(F, field, square)))), A.Algebra.add(~F, ~field, P.Problem.cosine(F, field, square), P.Problem.sine(F, field, square))),
  +hyp4: A.Algebra.le(~F, ~field, left, P.Problem.center_y(F, field, square)),
  +hyp5: A.Algebra.le(~F, ~field, P.Problem.center_y(F, field, square), A.Algebra.add(~F, ~field, left, gap)),
  +hyp6: A.Algebra.le(~F, ~field, A.Algebra.add(~F, ~field, R.FieldRing.of_nat(~F, ~field, 3n), A.Algebra.neg(~F, ~field, P.Problem.center_x(F, field, square))), height)) ->
  Or(P.Problem.Containment<F, field, square, P.Point{A.Algebra.add(~F, ~field, R.FieldRing.of_nat(~F, ~field, 3n), A.Algebra.neg(~F, ~field, height)), left}>, P.Problem.Containment<F, field, square, P.Point{A.Algebra.add(~F, ~field, R.FieldRing.of_nat(~F, ~field, 3n), A.Algebra.neg(~F, ~field, height)), A.Algebra.add(~F, ~field, left, gap)}>):
  match square corners:
    case P.Square{P.Point{+cx, +cy}, P.Frame{+c, +s, +ub, +ua}} M.Corners{P.InContainer{+low_low_left, +low_low_right, +low_low_bottom, +low_low_top}, P.InContainer{+low_high_left, +low_high_right, +low_high_bottom, +low_high_top}, P.InContainer{+high_low_left, +high_low_right, +high_low_bottom, +high_low_top}, P.InContainer{+high_high_left, +high_high_right, +high_high_bottom, +high_high_top}}:
      +q: P.Problem.Square<F, field> = P.Square{P.Point{cx, cy}, P.Frame{c, s, ub, ua}}
      +p0: P.Problem.Point<F> = P.Point{A.Algebra.add(~F, ~field, R.FieldRing.of_nat(~F, ~field, 3n), A.Algebra.neg(~F, ~field, height)), left}
      +lx0: F = G.Geometry.local_x(~F, ~field, q, p0)
      +ly0: F = G.Geometry.local_y(~F, ~field, q, p0)
      +p1: P.Problem.Point<F> = P.Point{A.Algebra.add(~F, ~field, R.FieldRing.of_nat(~F, ~field, 3n), A.Algebra.neg(~F, ~field, height)), A.Algebra.add(~F, ~field, left, gap)}
      +lx1: F = G.Geometry.local_x(~F, ~field, q, p1)
      +ly1: F = G.Geometry.local_y(~F, ~field, q, p1)
