def Stromquist.key0(~F: Kind(&2), ~field: K.Field<F>) -> P.Problem.Point<F>:
  P.Point{R.FieldRing.of_nat(~F, ~field, 1n), R.FieldRing.of_nat(~F, ~field, 1n)}

def Stromquist.key1(~F: Kind(&2), ~field: K.Field<F>) -> P.Problem.Point<F>:
  P.Point{A.Algebra.add(~F, ~field, R.FieldRing.of_nat(~F, ~field, 1n), A.Algebra.half(~F, ~field)), R.FieldRing.of_nat(~F, ~field, 1n)}

def Stromquist.key2(~F: Kind(&2), ~field: K.Field<F>) -> P.Problem.Point<F>:
  P.Point{R.FieldRing.of_nat(~F, ~field, 2n), R.FieldRing.of_nat(~F, ~field, 1n)}

def Stromquist.key3(~F: Kind(&2), ~field: K.Field<F>) -> P.Problem.Point<F>:
  P.Point{R.FieldRing.of_nat(~F, ~field, 1n), A.Algebra.add(~F, ~field, R.FieldRing.of_nat(~F, ~field, 1n), A.Algebra.half(~F, ~field))}

def Stromquist.key4(~F: Kind(&2), ~field: K.Field<F>) -> P.Problem.Point<F>:
  P.Point{A.Algebra.add(~F, ~field, R.FieldRing.of_nat(~F, ~field, 1n), A.Algebra.half(~F, ~field)), A.Algebra.add(~F, ~field, R.FieldRing.of_nat(~F, ~field, 1n), A.Algebra.half(~F, ~field))}

def Stromquist.key5(~F: Kind(&2), ~field: K.Field<F>) -> P.Problem.Point<F>:
  P.Point{R.FieldRing.of_nat(~F, ~field, 2n), A.Algebra.add(~F, ~field, R.FieldRing.of_nat(~F, ~field, 1n), A.Algebra.half(~F, ~field))}

def Stromquist.key6(~F: Kind(&2), ~field: K.Field<F>) -> P.Problem.Point<F>:
  P.Point{R.FieldRing.of_nat(~F, ~field, 1n), R.FieldRing.of_nat(~F, ~field, 2n)}

def Stromquist.key7(~F: Kind(&2), ~field: K.Field<F>) -> P.Problem.Point<F>:
  P.Point{A.Algebra.add(~F, ~field, R.FieldRing.of_nat(~F, ~field, 1n), A.Algebra.half(~F, ~field)), R.FieldRing.of_nat(~F, ~field, 2n)}

def Stromquist.key8(~F: Kind(&2), ~field: K.Field<F>) -> P.Problem.Point<F>:
  P.Point{R.FieldRing.of_nat(~F, ~field, 2n), R.FieldRing.of_nat(~F, ~field, 2n)}

def Stromquist.row(~F: Kind(&2), ~field: K.Field<F>, +square: P.Problem.Square<F, field>) -> List<&2, Bool>:
  I.Incidence.row(M.Membership.inside(~F, ~field, square, Stromquist.key0(~F, ~field)), M.Membership.inside(~F, ~field, square, Stromquist.key1(~F, ~field)), M.Membership.inside(~F, ~field, square, Stromquist.key2(~F, ~field)), M.Membership.inside(~F, ~field, square, Stromquist.key3(~F, ~field)), M.Membership.inside(~F, ~field, square, Stromquist.key4(~F, ~field)), M.Membership.inside(~F, ~field, square, Stromquist.key5(~F, ~field)), M.Membership.inside(~F, ~field, square, Stromquist.key6(~F, ~field)), M.Membership.inside(~F, ~field, square, Stromquist.key7(~F, ~field)), M.Membership.inside(~F, ~field, square, Stromquist.key8(~F, ~field)))

def Stromquist.unit(~F: Kind(&2), ~field: K.Field<F>, +square: P.Problem.Square<F, field>) ->
  C.Certificate.Both<A.Algebra.le(~F, ~field, A.Algebra.add(~F, ~field, A.Algebra.add(~F, ~field, A.Algebra.mul(~F, ~field, P.Problem.cosine(F, field, square), P.Problem.cosine(F, field, square)),
    A.Algebra.mul(~F, ~field, P.Problem.sine(F, field, square), P.Problem.sine(F, field, square))), A.Algebra.neg(~F, ~field, R.FieldRing.of_nat(~F, ~field, 1n))), A.Algebra.zero(~F, ~field)),
    A.Algebra.le(~F, ~field, A.Algebra.zero(~F, ~field), A.Algebra.add(~F, ~field, A.Algebra.add(~F, ~field, A.Algebra.mul(~F, ~field, P.Problem.cosine(F, field, square), P.Problem.cosine(F, field, square)),
    A.Algebra.mul(~F, ~field, P.Problem.sine(F, field, square), P.Problem.sine(F, field, square))), A.Algebra.neg(~F, ~field, R.FieldRing.of_nat(~F, ~field, 1n))))>:
  match square:
    case P.Square{+center, P.Frame{+c, +s, +ub, +ua}}:
      G.Geometry.unit(~F, ~field, c, s, ub, ua)

