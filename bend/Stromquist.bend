def Stromquist.key0(~F: Kind(&2), ~field: K.Field<F>) -> P.Problem.Point<F>:
  P.Point{R.FieldRing.of_nat(~F, ~field, 1n), R.FieldRing.of_nat(~F, ~field, 1n)}

def Stromquist.key1(~F: Kind(&2), ~field: K.Field<F>) -> P.Problem.Point<F>:
  P.Point{A.Algebra.add(~F, ~field, R.FieldRing.of_nat(~F, ~field, 1n), A.Algebra.half(~F, ~field)), R.FieldRing.of_nat(~F, ~field, 1n)}

def Stromquist.key2(~F: Kind(&2), ~field: K.Field<F>) -> P.Problem.Point<F>:
  P.Point{R.FieldRing.of_nat(~F, ~field, 2n), R.FieldRing.of_nat(~F, ~field, 1n)}

def Stromquist.key3(~F: Kind(&2), ~field: K.Field<F>) -> P.Problem.Point<F>:
